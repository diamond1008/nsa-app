# ==========================================================================
# NSA Training Platform — Environment Variables Template
# Copy this file to ".env" and fill in real values for LOCAL development.
# NEVER commit ".env". Production secrets must come from a secret manager.
# ==========================================================================

# ---------- PostgreSQL (used by compose.yaml, Phase 1) ----------
POSTGRES_USER=nsa
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=nsa_training
POSTGRES_PORT=5432

# Full connection string used by the API (Goose migrations reuse it too).
DATABASE_URL=postgres://nsa:change-me-local-only@localhost:5432/nsa_training?sslmode=disable

# ---------- API (apps/api, Phase 2) ----------
API_PORT=8080
# Allowed values: development | staging | production
APP_ENV=development
# slog level: debug | info | warn | error
LOG_LEVEL=debug
# Comma-separated list. Narrow this in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Graceful shutdown timeout in seconds.
SHUTDOWN_TIMEOUT_SECONDS=10

# ---------- Authentication / Tokens (Phase 3) ----------
# Signs JWT access tokens. REQUIRED, minimum 32 characters.
# Generate strong random values for real environments, e.g.:
#   openssl rand -base64 48   (or)   [guid]::NewGuid() in PowerShell
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# NOTE: refresh tokens are OPAQUE random strings (not JWTs) — only their
# SHA-256 hash is stored in the database, so no refresh secret is needed.
# Bcrypt cost factor (10-12 recommended for dev; review for production).
BCRYPT_COST=10

# ---------- Google & Microsoft OAuth (SSO) ----------
# Optional in dev (simulation used when unset); set to use real Google & Microsoft login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ---------- Web (apps/web, Phase 8) ----------
# Vite exposes only variables prefixed with VITE_ to the browser.
VITE_API_BASE_URL=http://localhost:8080/api/v1