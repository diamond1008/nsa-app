# NSA Training Platform — SPA static hosting.
# Serves the Vite build output with client-side routing fallback.

:80

root * /srv
encode zstd gzip

# Security headers (match the API's defensive posture).
header {
	X-Content-Type-Options nosniff
	X-Frame-Options DENY
	Referrer-Policy strict-origin-when-cross-origin
	-Server
}

@immutable path /assets/*
header @immutable Cache-Control "public, max-age=31536000, immutable"

@html {
	not path /assets/*
}
header @html Cache-Control "no-cache"

# Client-side routing: unknown paths fall back to index.html.
try_files {path} /index.html

file_server
