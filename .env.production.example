# Copy to .env.production on the deployment host; never commit real values.
APP_DOMAIN=training.example.com
TLS_EMAIL=ops@example.com
POSTGRES_USER=nsa
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=nsa_training
DATABASE_URL=postgres://nsa:replace-with-a-long-random-password@postgres:5432/nsa_training?sslmode=disable
JWT_ACCESS_SECRET=replace-with-at-least-48-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_COST=12
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_SECONDS=20

# Optional: AI Workflow Engine (OpenRouter / Gemini / Groq)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: Google & Microsoft OAuth 2.0 SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional: Cloudflare R2 Object Storage (for PDF certificates/diplomas)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nsa-diplomas
R2_PUBLIC_URL=

