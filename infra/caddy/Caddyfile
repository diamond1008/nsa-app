{
	email {$TLS_EMAIL}
}

(app_proxy) {
	encode zstd gzip
	log {
		output stdout
		format json
	}

	header {
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https:; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com data:; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@api path /api/* /health /ready /docs /openapi.yaml
	reverse_proxy @api api:8080 {
		header_up X-Real-IP {remote_host}
		header_up -True-Client-IP
	}
	reverse_proxy web:80
}

{$APP_DOMAIN:localhost} {
	import app_proxy
}

